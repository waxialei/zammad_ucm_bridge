def create_zammad_ticket(caller_id, caller_name, target_ext):
    headers = {
        'Authorization': f'Token token={ZAMMAD_TOKEN}',
        'Content-Type': 'application/json'
    }
    payload = {
        "title": f"Inbound Call from {caller_name} ({caller_id}) to Ext {target_ext}",
        "group": "Users",
        "customer_id": 1,
        "article": {
            "subject": f"Inbound Call Log - Ext {target_ext}",
            "body": f"Automatic Ticket Generated:\nCaller ID: {caller_id}\nCaller Name: {caller_name}\nTarget Extension: {target_ext}",
            "type": "phone",
            "internal": False
        }
    }
    try:
        response = requests.post(f"{ZAMMAD_URL}/api/v1/tickets", json=payload, headers=headers)
        if response.status_code == 201:
            print(f"[+] Ticket created successfully for Caller {caller_id} -> Ext {target_ext}")
        else:
            print(f"[-] Failed to create ticket: {response.text}")
    except Exception as e:
        print(f"[-] Exception during Zammad API request: {e}")

